{
  "name": "dasp-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:generate": "node scripts/build-docs.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev website",
    "docs:build": "npm run docs:generate && vitepress build website",
    "docs:preview": "vitepress preview website",
    "brand:build": "node scripts/build-brand.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "publication:check": "node scripts/check-publication.mjs",
    "site:check": "node scripts/check-site.mjs",
    "check": "npm run spec:check && npm run publication:check && npm run docs:build && npm run site:check",
    "release:prepare": "npm run check && node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "opentype.js": "^1.3.4",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
