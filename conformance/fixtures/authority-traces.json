{
  "scope": "Recorded admission decisions only. Sequences count admissions in these pending-command examples. No host or concurrent execution.",
  "scenarios": [
    {
      "id": "standing-across-sessions-and-expiry",
      "steps": [
        {
          "id": "first",
          "grant": "standing",
          "command": {
            "session_id": "session-counter",
            "command_id": "c1",
            "name": "counter.add",
            "input": {
              "amount": 3
            }
          },
          "expected": {
            "disposition": "accepted",
            "sequence": 1
          }
        },
        {
          "id": "second",
          "grant": "standing",
          "command": {
            "session_id": "session-counter",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 4
            }
          },
          "expected": {
            "disposition": "accepted",
            "sequence": 2
          }
        },
        {
          "id": "other-session",
          "grant": "standing",
          "command": {
            "session_id": "session-counter-two",
            "command_id": "c3",
            "name": "counter.add",
            "input": {
              "amount": 5
            }
          },
          "expected": {
            "disposition": "accepted",
            "sequence": 1
          }
        },
        {
          "id": "expired-new",
          "grant": "standing",
