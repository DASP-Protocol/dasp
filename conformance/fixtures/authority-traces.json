        {
          "id": "changed-input",
          "grant": "standing",
          "command": {
            "session_id": "session-counter",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 5
            }
          },
          "expected": {
            "error": "conflict"
