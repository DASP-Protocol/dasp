        {
          "id": "changed-known-grant",
          "grant": "changed-known-id",
          "command": {
            "session_id": "session-counter",
            "command_id": "c5",
            "name": "counter.add",
            "input": {
              "amount": 1
            }
          },
          "expected": {
            "error": "not_found"
          }
        }
