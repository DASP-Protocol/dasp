        {
          "id": "lost-receipt",
          "grant": "recover",
          "command": {
            "session_id": "session-counter",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 4
            }
          },
          "expected": {
            "disposition": "duplicate",
            "sequence": 2
          },
          "now": 1790816401
        },
        {
          "id": "revoked-equal",
          "grant": "standing",
          "command": {
            "session_id": "session-counter",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 4
            }
          },
          "expected": {
            "disposition": "duplicate",
            "sequence": 2
          },
          "revoked": true
        },
        {
          "id": "renewed-equal",
          "grant": "renewed",
          "command": {
            "session_id": "session-counter",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 4
            }
          },
          "expected": {
            "disposition": "duplicate",
            "sequence": 2
          },
          "now": 1790816401
