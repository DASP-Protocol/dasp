        {
          "id": "changed-session",
          "grant": "standing",
          "command": {
            "session_id": "session-counter-two",
            "command_id": "c2",
            "name": "counter.add",
            "input": {
              "amount": 4
            }
          },
          "expected": {
            "error": "conflict"
          }
        },
        {
          "id": "denied-recovery",
          "grant": "recover",
