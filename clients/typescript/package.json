{
  "name": "@dasp-protocol/client",
  "version": "0.1.0-draft.1",
  "description": "Transport-independent client for DASP draft-01",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DASP-Protocol/dasp.git",
    "directory": "clients/typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "example": "npm run build && node examples/recorded.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.20.4"
  }
}
