{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dasp-protocol.github.io/dasp/schemas/draft-01/examples/counter-profile.schema.json",
  "title": "Illustrative counter profile payloads",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}
